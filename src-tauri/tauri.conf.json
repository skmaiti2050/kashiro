{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kashiro",
  "mainBinaryName": "Kashiro",
  "version": "1.2.1",
  "identifier": "app.kashiro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run check:llama && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kashiro",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser", "installerHooks": "nsis/close-app.nsh" }
    },
    "resources": {
      "../resources/dictionary/oewn.json.gz": "dictionary/oewn.json.gz",
      "binaries/llama/*": "llama/",
      "binaries/vulkan/*": "llama/vulkan/",
      "../LICENSE": "LICENSE.txt",
      "../README.md": "README.md",
      "../docs/INSTALL.md": "INSTALL.md",
      "../resources/dictionary/ATTRIBUTION.md": "notices/dictionary.md",
      "../resources/frequency/ATTRIBUTION.md": "notices/word-frequencies.md",
      "../resources/romanised/ATTRIBUTION.md": "notices/indian-languages.md",
      "../resources/fonts/ATTRIBUTION.md": "notices/fonts.md",
      "../resources/i18n/ATTRIBUTION.md": "notices/interface-text.md",
      "../resources/harper/ATTRIBUTION.md": "notices/harper.md",
      "../resources/llama/ATTRIBUTION.md": "notices/llama-cpp.md",
      "../resources/notices/THIRD-PARTY-NOTICES.txt": "notices/THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
