{
  "csp": {
    "csp": {
      "default-src": [
        "'self'"
      ],
      "connect-src": [
        "'self'",
        "ipc:",
        "http://ipc.localhost"
      ],
      "img-src": [
        "'self'",
        "data:"
      ],
      "style-src": [
        "'self'",
        "'unsafe-inline'"
      ],
      "script-src": [
        "'self'",
        "'wasm-unsafe-eval'"
      ]
    },
    "devCsp": {
      "default-src": [
        "'self'"
      ],
      "connect-src": [
        "'self'",
        "ipc:",
        "http://ipc.localhost",
        "ws://localhost:1420"
      ],
      "img-src": [
        "'self'",
        "data:"
      ],
      "style-src": [
        "'self'",
        "'unsafe-inline'"
      ],
      "script-src": [
        "'self'",
        "'unsafe-inline'",
        "'wasm-unsafe-eval'"
      ]
    }
  },
  "capabilities": {
    "default": [
      "window main",
      "core:default",
      "core:window:allow-destroy",
      "dialog:allow-open",
      "dialog:allow-save",
      "fs:allow-read-file",
      "fs:allow-write-file",
      "store:default",
      "allow-overwrite-with-backup",
      "allow-session-save",
      "allow-session-load",
      "allow-session-list",
      "allow-session-delete",
      "allow-session-prune",
      "platforms all",
      "local true"
    ]
  },
  "settings": {}
}
